// Tech tree. Generated from tools/content_gen/gen_content.py.
[
    (id: "hand_tools", name: "Hand Tools", era: 0, parents: [], cost: [("timber",5)], unlocks: ["workbench","storage_crate","research_desk","hand_timber_block","hand_ladder","hand_oil_lamp","hand_research_desk"], description: "Set up the camp: workbench, crates and light."),
    (id: "masonry", name: "Masonry", era: 1, parents: ["hand_tools"], cost: [("clay_lump",10),("timber",6)], unlocks: ["brick_kiln","kiln_brick","kiln_glass","kiln_fire_brick","brick_block"], description: "Fire clay into bricks and glass."),
    (id: "smelting", name: "Smelting", era: 1, parents: ["masonry"], cost: [("coal",10),("raw_copper",6),("raw_iron",6)], unlocks: ["stone_furnace","anvil","smelt_copper","smelt_iron","smelt_tin","smelt_bronze","anvil_iron_plate","anvil_copper_wire","anvil_iron_rod"], description: "Smelt ore into ingots and hammer them into parts."),
    (id: "steelmaking", name: "Steelmaking", era: 1, parents: ["smelting"], cost: [("iron_plate",12),("fire_brick",8),("limestone",8)], unlocks: ["blast_furnace","blast_steel","blast_steel_plate","anvil_hardened_pickaxe"], description: "Steel opens the Granite Depths."),
    (id: "steam_power", name: "Steam Power", era: 2, parents: ["steelmaking"], cost: [("steel_plate",20),("copper_pipe",10),("bronze_gear",5)], unlocks: ["hand_pump","steam_boiler","steam_engine","pipe_block","anvil_copper_pipe"], description: "Boil water, pipe the steam, drive machines."),
    (id: "ore_processing", name: "Ore Processing", era: 2, parents: ["steam_power"], cost: [("steel_plate",14),("bronze_gear",6)], unlocks: ["crusher","ore_washer","crusher_iron","washer_iron","smelt_washed_iron"], description: "Crush and wash ore for up to double yield."),
    (id: "logistics", name: "Logistics", era: 2, parents: ["steam_power"], cost: [("steel_plate",10),("rail",16),("conveyor",4)], unlocks: ["mine_lift","hand_conveyor"], description: "Rails, conveyors and lifts move the ore home."),
    (id: "steam_drill", name: "Steam Drill", era: 2, parents: ["steam_power","ore_processing"], cost: [("steel_ingot",8),("copper_pipe",6),("bronze_gear",4)], unlocks: ["anvil_drill_head","anvil_steam_drill","anvil_empty_canister"], description: "A drill that runs on canisters filled at the boiler."),
    (id: "electricity", name: "Electricity", era: 3, parents: ["steam_power","steelmaking"], cost: [("copper_wire",20),("steel_plate",16),("turbine_blade",2)], unlocks: ["steam_turbine","generator","cable_block","hand_cable"], description: "Turn steam into power and run it down cables."),
    (id: "arc_smelting", name: "Arc Smelting", era: 3, parents: ["electricity"], cost: [("steel_plate",18),("graphite",12),("copper_wire",16)], unlocks: ["arc_furnace","arc_silicon","arc_steel","arc_aluminium"], description: "Electric furnaces melt faster and refine silicon."),
    (id: "electrolysis", name: "Electrolysis", era: 3, parents: ["electricity"], cost: [("steel_plate",14),("glass",6),("salt",10)], unlocks: ["electrolysis_cell","electro_aluminium","electro_salt","electro_acid"], description: "Split salt and ore with current."),
    (id: "circuits", name: "Circuits", era: 3, parents: ["electricity","arc_smelting"], cost: [("silicon",6),("copper_wire",12)], unlocks: ["circuit_assembler","circuit_mk1","anvil_headlamp_mk2"], description: "Silicon and wire become control circuits."),
    (id: "energy_storage", name: "Energy Storage", era: 3, parents: ["electricity","circuits"], cost: [("lead_plate",10),("sulfuric_acid",6),("circuit_mk1",2)], unlocks: ["battery_bank","charging_station","assembler_battery","assembler_battery_cell"], description: "Batteries smooth the grid and power tools."),
    (id: "ventilation", name: "Ventilation", era: 3, parents: ["electricity","circuits"], cost: [("steel_plate",8),("circuit_mk1",2)], unlocks: ["vent_fan","electric_pump"], description: "Clear gas pockets and pump out flooded tunnels."),
    (id: "ore_scanner", name: "Ore Scanner", era: 3, parents: ["circuits"], cost: [("circuit_mk1",4),("glass",4)], unlocks: ["anvil_ore_scanner"], description: "Reveals ore within sixteen blocks."),
    (id: "chemistry", name: "Chemistry", era: 4, parents: ["circuits","electrolysis"], cost: [("sulfuric_acid",8),("fluorite",4),("glass",8)], unlocks: ["chemical_plant","chem_acid","chem_fluorine","chem_lye"], description: "Acids and fluorine compounds at scale."),
    (id: "alloy_metallurgy", name: "Deep Metallurgy", era: 4, parents: ["steelmaking","chemistry"], cost: [("nickel_ingot",6),("chromium_ingot",6),("graphite",8)], unlocks: ["alloy_furnace","alloy_stainless","alloy_tungsten_carbide","alloy_nickel"], description: "Stainless steel and tungsten carbide."),
    (id: "machine_shop", name: "Machine Shop", era: 4, parents: ["alloy_metallurgy","circuits"], cost: [("stainless_steel",10),("bearing",4)], unlocks: ["machine_shop","shop_bearing","shop_turbine_blade","shop_stainless_rotor"], description: "Precision parts: bearings, rotors, casings."),
    (id: "rare_earths", name: "Rare Earths", era: 4, parents: ["machine_shop"], cost: [("monazite_sand",8),("sulfuric_acid",4)], unlocks: ["rare_earth_separator","sep_monazite","shop_rare_earth_motor"], description: "Monazite becomes magnets for motors and centrifuges."),
    (id: "hazard_gear", name: "Hazard Gear", era: 4, parents: ["machine_shop","chemistry"], cost: [("stainless_steel",8),("lead_plate",8),("circuit_mk1",2)], unlocks: ["decon_shower","shop_cooling_suit","shop_respirator","shop_hazmat_suit","shop_geiger_counter"], description: "Survive heat, gas and radiation in the Deep Crust."),
    (id: "tungsten_drill", name: "Tungsten-Carbide Drill", era: 4, parents: ["machine_shop","hazard_gear"], cost: [("tungsten_carbide",6),("battery_cell",4),("steel_rod",4)], unlocks: ["shop_tungsten_drill_head","shop_tungsten_drill"], description: "A battery drill that bites into layer five."),
    (id: "uranium_milling", name: "Uranium Milling", era: 5, parents: ["tungsten_drill","chemistry"], cost: [("crushed_uranium_ore",4),("sulfuric_acid",8)], unlocks: ["leaching_tank","precipitator","leach_uranium","precipitate_yellowcake"], description: "Crush, leach and precipitate uranium into yellowcake."),
    (id: "enrichment", name: "Enrichment", era: 5, parents: ["uranium_milling","rare_earths"], cost: [("yellowcake",2),("fluorine_compound",4),("stainless_rotor",2)], unlocks: ["conversion_plant","centrifuge","convert_uf6","centrifuge_enrich"], description: "Convert to UF6 and enrich it in a centrifuge cascade."),
    (id: "fuel_fabrication", name: "Fuel Fabrication", era: 5, parents: ["enrichment"], cost: [("enriched_canister",2),("zirconium_tubing",4)], unlocks: ["fuel_fabricator","fabricate_fuel_rod","fabricate_core_cell","fabricate_dense_shield"], description: "Enriched canisters become fuel rods and core cells."),
    (id: "reactor_tech", name: "Reactor", era: 5, parents: ["fuel_fabrication","alloy_metallurgy"], cost: [("fuel_rod",4),("control_rod",2),("graphite_block",8),("stainless_casing",4)], unlocks: ["reactor","reactor_console","scram_panel","coolant_pump","heat_exchanger","shop_control_rod"], description: "A 5x5x5 reactor producing twenty times the coal grid."),
    (id: "nuclear_drill", name: "Nuclear Drill", era: 5, parents: ["fuel_fabrication","tungsten_drill"], cost: [("compact_core_cell",1),("tungsten_drill_head",1),("rare_earth_motor",1)], unlocks: ["shop_nuclear_drill"], description: "Mines a 3x3 face per action, powered by a core cell."),
    (id: "waste_handling", name: "Waste Handling", era: 5, parents: ["reactor_tech"], cost: [("waste_cask",2),("dense_shielding_plate",2)], unlocks: ["cooling_pool","waste_vault","pool_spent_fuel"], description: "Cool spent fuel and lock it away."),
]
